pipeline {
    agent any

    stages {
        stage('Welcome') {
            steps {
                echo 'Hello! My first CI/CD pipeline.'
                echo 'My GitHub project is connected to Jenkins soon.'
            }
        }

        stage('Build') {
            steps {
                echo 'Build stage completed!'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage completed!'
            }
        }
    }
}
